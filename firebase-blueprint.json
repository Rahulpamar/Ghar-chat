    "time_capsule_request": {
      "title": "TimeCapsuleUnlockRequest",
      "description": "Fun bribe / request to capsule owner to unlock sealed time capsule for specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "capsuleId": { "type": "string" },
        "requesterId": { "type": "string" },
        "requesterName": { "type": "string" },
        "requesterAvatar": { "type": "string" },
        "requesterCode": { "type": "string" },
        "ownerCode": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "capsuleId", "requesterId", "message", "status", "createdAt"]
    }
