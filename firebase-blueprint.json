        "isUnlocked": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "unlockDate", "createdAt"]
    },
    "emergency_sos": {
      "title": "EmergencySosEvent",
      "description": "High-priority emergency panic drop with live location and battery info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhone": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "address": { "type": "string" },
        "batteryLevel": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "senderName", "timestamp", "status"]
    },
    "vibe_streak_tracker": {
      "title": "VibeStreakTracker",
      "description": "Automated daily streak tracker between connected users based on active messaging and streak shares",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userCode1": { "type": "string" },
        "userCode2": { "type": "string" },
        "user1Name": { "type": "string" },
        "user2Name": { "type": "string" },
        "streakCount": { "type": "number" },
        "lastInteractionAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "isExpiringSoon": { "type": "boolean" },
        "relationship": { "type": "string" }
      },
      "required": ["id", "userCode1", "userCode2", "streakCount", "lastInteractionAt"]
