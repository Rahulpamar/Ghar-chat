{
  "entities": {
    "user_profile": {
      "title": "UserProfile",
      "description": "Registered user profile with unique alphanumeric personal code and security PIN",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "displayName": { "type": "string" },
        "userCode": { "type": "string" },
        "avatar": { "type": "string" },
        "pinCode": { "type": "string" },
        "pinLockEnabled": { "type": "boolean" },
        "familyRoomCode": { "type": "string" },
        "connectors": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userCode"]
    },
    "chat_message": {
      "title": "ChatMessage",
      "description": "Family Room open message with Add to Private vault capability",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "privateForUserCode": { "type": "string" },
        "voiceUrl": { "type": "string" },
        "voiceDuration": { "type": "number" },
        "stickerEmoji": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "senderName", "text", "createdAt"]
    },
    "story_note": {
      "title": "StoryNote",
      "description": "Instagram-style 24-hour status note or 1-hour self-destructing ghost note shared with family and connectors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorCode": { "type": "string" },
        "note": { "type": "string" },
        "emoji": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "targetAudience": { "type": "string" },
        "isGhost": { "type": "boolean" }
      },
      "required": ["id", "authorName", "note", "createdAt"]
    },
    "connector": {
      "title": "Connector",
      "description": "Direct personal code connection between users with category, vibe match and status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userCode": { "type": "string" },
        "connectedUserCode": { "type": "string" },
        "connectedUserName": { "type": "string" },
        "connectedUserAvatar": { "type": "string" },
        "connectedUserPhone": { "type": "string" },
        "status": { "type": "string" },
        "category": { "type": "string" },
        "vibeMatch": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userCode", "connectedUserCode"]
    },
    "daily_streak_post": {
      "title": "DailyStreakPost",
      "description": "Rich social post with photo, caption, daily quote, location tag, audience target, likes and comments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorCode": { "type": "string" },
        "locationTag": { "type": "string" },
        "photoUrl": { "type": "string" },
        "note": { "type": "string" },
        "quote": { "type": "string" },
        "streakCount": { "type": "number" },
        "targetAudience": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "comments": { "type": "array" },
        "reactions": { "type": "object" },
        "feedType": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorName", "note", "createdAt"]
    },
    "time_capsule": {
      "title": "TimeCapsule",
      "description": "Locked digital memory capsule scheduled to unlock on a future date",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "photoUrl": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "targetAudience": { "type": "string" },
